[dialog]
  caption = "World Atlas for Windows Installation"
  include = "Include anthems and flags (810 kb)"

[startup]
  line1 = "Installing World Atlas for Windows"
  line2 = "Setup will install this application into the following directory, which it will create on your hard disk."
  line3 = "If you want to install this application into a different directory and/or drive, type the name of the directory."

[misc]
  compress = ".TRC"

[data]
  defdir = C:\WAW

[disks]
  1 =.,"World Atlas for Windows, Disk 1 of 7"
  2 =.,"World Atlas for Windows, Disk 2 of 7"
  3 =.,"World Atlas for Windows, Disk 3 of 7"
  4 =.,"World Atlas for Windows, Disk 4 of 7"
  5 =.,"World Atlas for Windows, Disk 5 of 7"
  6 =.,"World Atlas for Windows, Disk 6 of 7"
  7 =.,"World Atlas for Windows, Disk 7 of 7"

[needed.space]
  minspace = 11151000
  waspace = 11965000

[app.copy.appstuff]
  #app.main,	0:
  #app.icons,   0:icons
  #app.relief,  0:

[app.copy.appfull]
  #app.main,    0:
  #app.icons,   0:icons
  #app.relief,  0:
  #app.extra,   0:

[app.main]
  1:info2.dat,"data"
  1:info1.dat+
  2:info1.002
  2:stat.dat
  2:statobj.dat
  2:topic.dat
  2:currency.dat
  2:source.dat
  2:europe.trc,"maps"
  2:wawlabel.trc
  3:africa.trc
  3:america.trc
  3:lsans.ttf
  4:asia.trc
  4:name.dat
  4:lbrite.ttf
  4:wahlp.trc,"online help"
  4:waexe.trc,"program"
  4:atlasdll.dll
  4:ctl3d.dll
  5:accusoft.trc
  5:commdlg.trc
  5:twrxedit.trc
  5:index.dat,"data"
  5:citymaps.trc,"maps"

