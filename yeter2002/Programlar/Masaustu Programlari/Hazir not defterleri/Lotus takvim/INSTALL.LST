[Params]
        WndTitle     = Welcome to the Lotus Installation Program
        WndMess1     = Please wait while the install program copies its files to your hard disk.
        WndMess2     = Please wait while the install program searches your hard disk for previous versions of Lotus applications.
        TmpDirSize   = 1500
        WinDirSize   = 10000
        LotusAppSize   = 9000
        TmpDirName   = lotustmp
        CmdLine      = lsirun.exe start /S %s %s
        DrvModName   = lsirun
        ArchiveName  = install.dsk
        ShowVersion  = No

[Files]
        cinstall.ini  = cinstall.ini
        ivcw.dll     = ivcw.dll
        unarjw.dll   = unarjw.dll

